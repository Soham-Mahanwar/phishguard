rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "soaham110@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidUser(data) {
      return data.uid is string && data.email is string;
    }

    function isValidAnalysis(data) {
      return data.uid is string &&
             data.cropName is string &&
             (data.type == 'health' || data.type == 'price') &&
             data.status is string &&
             data.image is string &&
             data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && isValidUser(request.resource.data) && 
                      (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'user');
      allow update: if (isOwner(uid) && isValidUser(request.resource.data) && 
                        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == resource.data.role)) || isAdmin();
      
      match /analyses/{analysisId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && isValidAnalysis(request.resource.data) && 
                        request.resource.data.createdAt == request.time;
        allow update: if isOwner(uid) && isValidAnalysis(request.resource.data);
        allow delete: if isOwner(uid) || isAdmin();
      }
    }

    match /test/connection {
      allow read: if isAuthenticated();
    }
  }
}
