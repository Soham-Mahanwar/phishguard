{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "CropAnalysis": {
      "title": "CropAnalysis",
      "description": "Historical crop analysis data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "cropName": { "type": "string" },
        "type": { "type": "string", "enum": ["health", "price"] },
        "status": { "type": "string" },
        "price": { "type": "string" },
        "data": { "type": "object" },
        "image": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "cropName", "type", "status", "data", "image", "createdAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "UserProfile" },
      "description": "User profiles"
    },
    "/users/{uid}/analyses/{analysisId}": {
      "schema": { "$ref": "CropAnalysis" },
      "description": "User's crop analysis history"
    }
  }
}
