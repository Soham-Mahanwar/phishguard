# Local Ollama endpoint - no API key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# SQLite database file path
DB_PATH=./phishing_detector.db

# Hard timeout (seconds) for the single Ollama explanation call before
# falling back to raw tool outputs without an AI explanation. Ollama unloads
# idle models from memory after a few minutes, so the first call after a
# period of inactivity can take 15-25s just to reload the model - 10s was
# too tight and caused spurious fallbacks. 30s covers a cold load; once the
# model is warm, calls typically take 1-3s.
OLLAMA_TIMEOUT_SECONDS=30

# Cache validity window in hours - repeat checks within this window are served from cache
CACHE_TTL_HOURS=24
